{
  "multipart": [
    { "when": { "n": "true", "e": "true", "s": "true", "w": "true" },
      "apply": { "model": "hexerei:block/rune_cross" } },

    { "when": { "n": "true", "e": "true", "s": "true", "w": "false" },
      "apply": { "model": "hexerei:block/rune_t" } },
    { "when": { "n": "false", "e": "true", "s": "true", "w": "true" },
      "apply": { "model": "hexerei:block/rune_t", "y": 90 } },
    { "when": { "n": "true", "e": "false", "s": "true", "w": "true" },
      "apply": { "model": "hexerei:block/rune_t", "y": 180 } },
    { "when": { "n": "true", "e": "true", "s": "false", "w": "true" },
      "apply": { "model": "hexerei:block/rune_t", "y": 270 } },

    { "when": { "n": "true", "e": "false", "s": "true", "w": "false" },
      "apply": { "model": "hexerei:block/rune_line" } },
    { "when": { "n": "false", "e": "true", "s": "false", "w": "true" },
      "apply": { "model": "hexerei:block/rune_line", "y": 90 } },

    { "when": { "n": "true", "e": "true", "s": "false", "w": "false" },
      "apply": { "model": "hexerei:block/rune_corner" } },
    { "when": { "n": "false", "e": "true", "s": "true", "w": "false" },
      "apply": { "model": "hexerei:block/rune_corner", "y": 90 } },
    { "when": { "n": "false", "e": "false", "s": "true", "w": "true" },
      "apply": { "model": "hexerei:block/rune_corner", "y": 180 } },
    { "when": { "n": "true", "e": "false", "s": "false", "w": "true" },
      "apply": { "model": "hexerei:block/rune_corner", "y": 270 } },

    { "when": { "n": "true", "e": "false", "s": "false", "w": "false" },
      "apply": { "model": "hexerei:block/rune_end" } },
    { "when": { "n": "false", "e": "true", "s": "false", "w": "false" },
      "apply": { "model": "hexerei:block/rune_end", "y": 90 } },
    { "when": { "n": "false", "e": "false", "s": "true", "w": "false" },
      "apply": { "model": "hexerei:block/rune_end", "y": 180 } },
    { "when": { "n": "false", "e": "false", "s": "false", "w": "true" },
      "apply": { "model": "hexerei:block/rune_end", "y": 270 } },
    { "when": { "n": "false", "e": "false", "s": "false", "w": "false" },
      "apply": { "model": "hexerei:block/rune_end" } },

    { "when": { "ne": "true" }, "apply": { "model": "hexerei:block/rune_diagonal" } },
    { "when": { "se": "true" }, "apply": { "model": "hexerei:block/rune_diagonal", "y": 90 } },
    { "when": { "sw": "true" }, "apply": { "model": "hexerei:block/rune_diagonal", "y": 180 } },
    { "when": { "nw": "true" }, "apply": { "model": "hexerei:block/rune_diagonal", "y": 270 } }
  ]
}
